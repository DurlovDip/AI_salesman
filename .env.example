# ============================================================
#  AI Salesman — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
#   cp .env.example .env
# Never commit .env or facebook_pages.json.

# ── Meta Platform ────────────────────────────────────────────
# Fabingo app (Development): https://developers.facebook.com/apps/2331344683941720/
META_APP_ID=2331344683941720
META_APP_SECRET=your_app_secret_here
META_VERIFY_TOKEN=fashionarc_verify_2024

# Facebook Page token for Fabingo. Create it in the Meta console.
# Do not paste it into facebook_pages.json.
META_PAGE_ACCESS_TOKEN=your_page_access_token_here
# Fabingo Page (Fashion ARC / fa.bingo). Public id, not a secret.
META_PAGE_ID=970073619531937

# Instagram professional account id linked to the Fabingo Page.
# Optional for webhook receive. Send uses the Page token above.
META_IG_ID=

# WhatsApp Business API (Cloud API). Untested until you set the flag below.
META_WHATSAPP_TOKEN=your_whatsapp_token_here
META_WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id_here

# ── Channel flags ────────────────────────────────────────────
# Each surface is independent. New surfaces default off.
# Messenger stays on so the existing DM path keeps working once a token is set.
ENABLE_MESSENGER=true
ENABLE_WHATSAPP=false
ENABLE_INSTAGRAM=false
ENABLE_PAGE_COMMENTS=false
ENABLE_PAGE_REACTIONS=false
# Graph conversation polling. Leave false and use webhooks.
ENABLE_MESSENGER_POLLING=false

# ── External APIs ────────────────────────────────────────────
# Your Fashion ARC backend
FASHION_ARC_API_URL=https://fashionarc-backend.vercel.app

# Set this only if a Multi-AI service is actually running.
# Leaving it unset is correct. The code's localhost default is NOT treated as configured.
# MULTI_AI_API_URL=http://localhost:8000

# Direct AI keys. At least one is required to generate replies.
# A Page token cannot replace these.
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
GROQ_API_KEY=your_groq_key_here

# ── Supabase Database ─────────────────────────────────────────
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# ── Store Branding ───────────────────────────────────────────
STORE_NAME=Fashion ARC
STORE_URL=https://fa.bingo
STORE_CURRENCY=BDT

# ── Conversation Settings ────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30
MAX_HISTORY_MESSAGES=20

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
DEBUG=true
